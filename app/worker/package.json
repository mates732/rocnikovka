{
  "name": "phytometer-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Phytometer API — Cloudflare Worker (D1 + R2)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "db:migrate:local": "wrangler d1 migrations apply phytometer-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply phytometer-db --remote",
    "migrate:sqlite-to-d1": "tsx scripts/migrate-sqlite-to-d1.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "jose": "^6.2.12",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.0"
  }
}
