# Phytometer — environment configuration
#
# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT
# ---------------------------------------------------------------------------
# Leave VITE_API_BASE_URL unset. Every API call then uses a relative path
# (e.g. /api/plants) and the Vite dev server proxies it to the backend
# running on http://localhost:3001 (see vite.config.ts).
#
#   cd app
#   npm install
#   npm run dev          # frontend  -> http://localhost:5173
#   cd server && npm run db:init   # backend   -> http://localhost:3001
#
# ---------------------------------------------------------------------------
# PRODUCTION
# ---------------------------------------------------------------------------
# The Vercel deployment hosts the STATIC FRONTEND ONLY. The Node/TypeScript
# backend in app/server/ is not deployed by Vercel and must be hosted
# separately (persistent disk required: SQLite + local image storage).
#
# Set VITE_API_BASE_URL to the deployed backend origin. The value is inlined
# into the frontend bundle at BUILD time, so the app must be rebuilt after the
# variable changes.
#
#   VITE_API_BASE_URL=https://api.example.com
#
# Do NOT append a trailing slash and do NOT include the /api path prefix;
# the app appends /api/... itself.
#
# IMPORTANT: until a backend is deployed and this variable is set, every
# /api/* request resolves to the frontend origin and returns HTTP 404. The
# application reports that as an error — it never fabricates empty data.

# Local development backend (used by the Vite dev server proxy)
VITE_API_ORIGIN=http://localhost:3001

# Production frontend build: origin of the separately hosted Node backend.
# Leave empty/undefined unless a backend is actually deployed.
# VITE_API_BASE_URL=
